// Copy this file to secrets.h and fill in real values.
// secrets.h is git-ignored.
#pragma once

// 2.4 GHz only - the classic ESP32 cannot see 5 GHz networks.
// Campus Wi-Fi with WPA2-Enterprise will not work here; use a phone hotspot.
#define WIFI_SSID     "your-2.4ghz-ssid"
#define WIFI_PASSWORD "your-password"

// Backend base URL, no trailing slash. Use the laptop LAN IP, not "localhost".
#define API_BASE_URL  "http://192.168.43.10:8000"

// Unique per device. Keep it stable: ingest dedupes on device_id + seq.
#define DEVICE_ID     "esp32-campuspulse"

// Minutes to add to UTC for local display (Malaysia = 480).
#define TZ_OFFSET_MIN 480
